# Dockerfile.cosyvoice - CosyVoice 2 TTS Server for GPU
# Based on FunAudioLLM/CosyVoice2 with HTTP API for streaming and voice cloning

FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev \
    ffmpeg libsndfile1 git curl \
    && rm -rf /var/lib/apt/lists/*

# Create python symlink
RUN ln -sf /usr/bin/python3.12 /usr/bin/python && \
    ln -sf /usr/bin/python3.12 /usr/bin/python3

# Install pip
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

WORKDIR /app

# Install Python dependencies
# torch with CUDA 12.4 support
RUN pip install --no-cache-dir \
    torch==2.4.0 \
    torchaudio==2.4.0 \
    --index-url https://download.pytorch.org/whl/cu124

# Core dependencies - CosyVoice requirements
RUN pip install --no-cache-dir \
    fastapi==0.110.0 \
    uvicorn==0.30.0 \
    pydantic==2.8.0 \
    soundfile==0.12.1 \
    numpy==1.26.4 \
    scipy==1.13.0 \
    httpx==0.27.0 \
    einops==0.8.0 \
    transformers==4.41.0 \
    accelerate==0.30.1 \
    huggingface_hub==0.23.0 \
    safetensors==0.4.3 \
    modelscope==1.9.5 \
    funasr==1.0.5

# Clone CosyVoice repository
RUN git clone https://github.com/FunAudioLLM/CosyVoice /opt/CosyVoice 2>/dev/null || true

# Copy server code (gpu_tts_common holds the shared, unit-tested cloning logic)
COPY cosyvoice_server.py /app/cosyvoice_server.py
COPY gpu_tts_common.py /app/gpu_tts_common.py

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app /opt/CosyVoice
USER appuser

# Model cache directory
ENV MODEL_CACHE_DIR=/app/models/cosyvoice
RUN mkdir -p $MODEL_CACHE_DIR

EXPOSE 5020

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:5020/health || exit 1

CMD ["python", "/app/cosyvoice_server.py"]
