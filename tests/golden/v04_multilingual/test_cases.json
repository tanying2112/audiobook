    {
      "id": "long_text_clone_001",
      "description": "Long text zero-shot clone (100+ chars)",
      "reference_audio": "tests/golden/v04_multilingual/ref_zh_female_001.wav",
      "target_text": "这是一个长文本零样本克隆测试。在这个测试中，我们将验证模型在处理较长文本时能否保持音色一致性、语调自然度以及语速稳定性。长文本合成是有声书制作中的核心场景，要求模型能够在几分钟的语音生成过程中始终保持参考音频的音色特征，不出现音色漂移、音调突变或语速异常等问题。",
      "target_language": "zh",
      "expected_speaker_similarity": 0.80,
      "engines": ["xtts_v2", "openvoice_v2", "cosyvoice_clone"]
    }
  ],
  "acceptance_criteria": {
    "cross_lingual_similarity_min": 0.80,
    "mono_lingual_similarity_min": 0.85,
    "streaming_first_chunk_latency_max_ms": 300,
    "voxcpm2_rtf_max": 0.15,
    "all_engines_health_check": true
  }
}
